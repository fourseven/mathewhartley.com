---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { popularPosts } from "../lib/popular-posts";
import { turnstileSiteKey } from "../lib/guestbook-config";

const guestbookSiteKey = turnstileSiteKey(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);

const allPosts = await getCollection("blog");

const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const postsById = new Map(allPosts.map((post) => [post.id, post]));

const popular = popularPosts
  .map((id) => postsById.get(id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mathew Hartley",
  url: "https://www.mathewhartley.com",
  jobTitle: "Senior Product Engineer",
  description:
    "Senior Product Engineer at Grw, building AI agents for sales and GTM teams. Previously CTO at Storypark. Builds with TypeScript, React, and data systems. Based in Wellington, New Zealand.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Wellington",
    addressCountry: "NZ",
  },
  sameAs: [
    "https://www.linkedin.com/in/mathew-hartley",
    "https://github.com/fourseven",
    "https://bsky.app/profile/fourseven.bsky.social",
    "https://twitter.com/four_seven",
  ],
};
---

<Base title="MathewHartley.com" jsonLd={personJsonLd}>
  <div class="hero">
    <h1>&#127775; Mathew Hartley &#127775;</h1>
    <p class="tagline">Senior Product Engineer &middot; Ex-CTO &middot; AI Agents</p>
    <p class="location">&#127758; Wellington, New Zealand</p>
  </div>

  <div class="experience-box">
    <h2>&#128187; About Me</h2>
    <p>
      Senior Product Engineer at <a href="https://grw.ai"><strong>Grw</strong></a>, building AI agents for sales and GTM teams, previously CTO at <a href="https://storypark.com"><strong>Storypark</strong></a>.
      I build things with TypeScript, React, and data systems, with a background in Ruby/Rails.
      Based in Wellington, where I recently swapped my emtb for a cargo ebike and traded flow trails for the school run. When I'm not writing code I'm usually trying to push the limits of what AI tools can do for personal productivity.
    </p>
  </div>

  <div class="latest-posts">
    <h2>&#128240; Latest Posts</h2>
    {posts.map((post) => (
      <div class="post-teaser">
        <span class="post-date">{post.data.date.toLocaleDateString("en-NZ", { year: "numeric", month: "short", day: "numeric" })}</span>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </div>
    ))}
    <p class="more-link"><a href="/blog">Read more &rarr;</a></p>
  </div>

  <div class="popular-posts">
    <h2>&#128293; Popular Posts</h2>
    {popular.map((post) => (
      <div class="post-teaser">
        <span class="post-date">{post.data.date.toLocaleDateString("en-NZ", { year: "numeric", month: "short", day: "numeric" })}</span>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </div>
    ))}
  </div>

  <div class="sidebar-box">
    <h3>&#128218; Quick Links</h3>
    <ul>
      <li><a href="/works">See my Works</a></li>
      <li><a href="https://github.com/fourseven">GitHub Profile</a></li>
      <li><a href="https://www.linkedin.com/in/mathew-hartley/">LinkedIn</a></li>
      <li><a href="/rss.xml">RSS Feed</a> &#128249;</li>
    </ul>
  </div>

  <section class="guestbook" aria-labelledby="guestbook-title">
    <h3 id="guestbook-title">&#128221; Guestbook</h3>
    {guestbookSiteKey ? (
      <>
        <script src="../client/guestbook.ts"></script>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <p class="guestbook-note">Leave a note. Entries appear after I approve them.</p>
        <form id="guestbook-form">
          <label for="guestbook-name">Name</label>
          <input id="guestbook-name" name="name" maxlength="40" required autocomplete="name" />
          <label for="guestbook-message">Message</label>
          <textarea id="guestbook-message" name="message" maxlength="500" rows="4" required></textarea>
          <div class="guestbook-honeypot" aria-hidden="true">
            <label for="guestbook-website">Leave this field blank</label>
            <input id="guestbook-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="cf-turnstile" data-sitekey={guestbookSiteKey} data-theme="dark"></div>
          <button type="submit">Sign guestbook</button>
          <p id="guestbook-status" role="status" aria-live="polite"></p>
        </form>
        <div id="guestbook-entries" class="guestbook-entries" aria-live="polite"></div>
      </>
    ) : (
      <p class="guestbook-note">The guestbook is being set up. Check back shortly.</p>
    )}
  </section>
</Base>

<style>
  .tagline {
    font-size: 1.2rem;
    color: var(--neon-cyan);
    margin-top: 0.5rem;
  }

  .location {
    font-size: 0.9rem;
    color: var(--neon-green);
    margin-top: 0.25rem;
  }

  .about-box {
    background: var(--dark-bg);
    border: 3px ridge var(--border-color);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .about-box h2 {
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    color: var(--neon-cyan);
    margin-top: 0;
  }

  .about-box p {
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .about-box p:last-child {
    margin-bottom: 0;
  }

  .experience-box {
    background: var(--dark-bg);
    border: 3px ridge var(--border-color);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .experience-box h2 {
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    color: var(--neon-pink);
    margin-top: 0;
  }

  .experience-box p {
    line-height: 1.6;
    margin: 0;
  }

  .latest-posts {
    background: var(--dark-bg);
    border: 3px ridge var(--border-color);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .latest-posts h2 {
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    color: var(--neon-pink);
    margin-top: 0;
  }

  .popular-posts {
    background: var(--dark-bg);
    border: 3px ridge var(--border-color);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }

  .popular-posts h2 {
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    color: var(--neon-green);
    margin-top: 0;
  }

  .post-teaser {
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .post-teaser:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .post-date {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .post-teaser a {
    color: var(--neon-green);
    font-weight: bold;
    text-decoration: none;
  }

  .post-teaser a:hover {
    text-decoration: underline;
  }

  .more-link {
    margin-top: 1rem;
    margin-bottom: 0;
    text-align: right;
  }

  .more-link a {
    color: var(--neon-cyan);
  }
</style>
