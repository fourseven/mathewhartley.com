---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>IRC</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <div id="irc-client">
    <div class="title-bar">
      <span class="title-text">mIRC</span>
      <div class="title-buttons">
        <span class="btn">_</span>
        <span class="btn">□</span>
        <span class="btn">×</span>
      </div>
    </div>

    <div class="menu-bar">
      <span class="menu-item">File</span>
      <span class="menu-item">Edit</span>
      <span class="menu-item">View</span>
      <span class="menu-item">Favorites</span>
      <span class="menu-item">Tools</span>
      <span class="menu-item">Window</span>
      <span class="menu-item">Help</span>
    </div>

    <div class="toolbar">
      <button class="tool-btn" title="Connect">🔗</button>
      <button class="tool-btn" title="Disconnect">⛓️‍💥</button>
      <button class="tool-btn" title="Channel List">📋</button>
      <button class="tool-btn" title="Options">⚙️</button>
      <div class="toolbar-spacer"></div>
      <button id="btn-new-channel" class="tool-btn" title="New Channel">🎲</button>
    </div>

    <div class="main-area">
      <div class="chat-panel">
        <div class="channel-header">
          <span class="channel-name" id="channel-name">#random</span>
          <span class="channel-topic" id="channel-topic">Topic: loading...</span>
          <span class="user-count" id="user-count">0 users</span>
        </div>
        <div class="chat-log" id="chat-log"></div>
        <div class="chat-input-area">
          <span class="input-prefix">You&gt;</span>
          <input id="chat-input" type="text" placeholder="Type a message..." autocomplete="off" />
          <button id="send-btn">Send</button>
        </div>
        <div class="status-bar" id="status-bar">Connecting...</div>
      </div>

      <div class="user-list-panel">
        <div class="user-list-header">Users</div>
        <div class="user-list" id="user-list"></div>
      </div>
    </div>
  </div>

  <script type="module">
    import { initIRCChat } from "/src/client/irc-chat.ts";
    const params = new URLSearchParams(window.location.search);
    const channelParam = params.get("channel") ?? "";
    const seed = channelParam.toLowerCase().replace(/[^a-z0-9-]/g, "").substring(0, 30) || null;
    const channel = seed || "random";
    document.title = `IRC — #${channel}`;
    document.getElementById("channel-name")!.textContent = `#${channel}`;
    initIRCChat(channel);
  </script>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #000033;
      background-image:
        radial-gradient(1px 1px at 10% 20%, #fff8, transparent),
        radial-gradient(1px 1px at 30% 65%, #fff6, transparent),
        radial-gradient(1.5px 1.5px at 55% 15%, #fffa, transparent),
        radial-gradient(1px 1px at 70% 80%, #fff5, transparent),
        radial-gradient(1px 1px at 85% 35%, #fff8, transparent);
      background-size: 250px 250px;
      font-family: "MS Sans Serif", "Microsoft Sans Serif", "Tahoma", "Arial", sans-serif;
      height: 100dvh;
      overflow: hidden;
    }

    #irc-client {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      max-width: 1000px;
      margin: 0 auto;
      background: #c0c0c0;
      border: 2px outset #fff;
      box-shadow: 3px 3px 0 #000;
      font-size: 13px;
    }

    .title-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(90deg, #000080, #1084d0);
      padding: 2px 4px;
      color: #fff;
      font-weight: bold;
      font-size: 12px;
    }

    .title-buttons {
      display: flex;
      gap: 2px;
    }

    .title-buttons .btn {
      width: 16px;
      height: 14px;
      background: #c0c0c0;
      border: 1px outset #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      font-weight: bold;
      color: #000;
      cursor: pointer;
    }

    .title-buttons .btn:active { border-style: inset; }

    .menu-bar {
      display: flex;
      gap: 0;
      background: #c0c0c0;
      border-bottom: 1px solid #808080;
      padding: 1px 0;
    }

    .menu-item {
      padding: 2px 8px;
      font-size: 11px;
      cursor: pointer;
    }

    .menu-item:hover {
      background: #000080;
      color: #fff;
    }

    .toolbar {
      display: flex;
      align-items: center;
      padding: 2px 4px;
      gap: 2px;
      background: #c0c0c0;
      border-bottom: 1px solid #808080;
    }

    .tool-btn {
      width: 24px;
      height: 22px;
      background: #c0c0c0;
      border: 2px outset #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
    }

    .tool-btn:active { border-style: inset; }

    .toolbar-spacer { flex: 1; }

    .main-area {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    .chat-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      border-right: 2px groove #808080;
      min-width: 0;
    }

    .channel-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 4px 8px;
      background: #c0c0c0;
      border-bottom: 1px solid #808080;
      font-size: 11px;
    }

    .channel-name {
      font-weight: bold;
      color: #000080;
    }

    .channel-topic {
      flex: 1;
      color: #444;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .user-count {
      color: #808080;
      font-size: 10px;
    }

    .chat-log {
      flex: 1;
      overflow-y: auto;
      padding: 4px 8px;
      background: #fff;
      font-family: "Fixedsys", "Courier New", monospace;
      font-size: 12px;
      line-height: 1.5;
    }

    .msg { margin-bottom: 1px; }

    .msg-time { color: #808080; }
    .msg-user { color: #000080; font-weight: bold; }
    .msg-text { color: #000; }
    .msg-action { color: #800080; font-style: italic; }
    .msg.system .msg-text { color: #808080; font-style: italic; }

    .chat-input-area {
      display: flex;
      align-items: center;
      padding: 4px 8px;
      background: #c0c0c0;
      border-top: 1px solid #808080;
      gap: 4px;
    }

    .input-prefix {
      font-weight: bold;
      color: #000080;
      font-size: 12px;
    }

    #chat-input {
      flex: 1;
      height: 22px;
      border: 2px inset #808080;
      background: #fff;
      font-family: "Fixedsys", "Courier New", monospace;
      font-size: 12px;
      padding: 0 4px;
    }

    #chat-input:disabled {
      background: #e0e0e0;
      color: #808080;
    }

    #send-btn {
      height: 22px;
      padding: 0 12px;
      background: #c0c0c0;
      border: 2px outset #fff;
      font-size: 11px;
      cursor: pointer;
    }

    #send-btn:active { border-style: inset; }
    #send-btn:disabled { color: #808080; cursor: default; }

    .status-bar {
      padding: 2px 8px;
      background: #c0c0c0;
      border-top: 1px solid #808080;
      font-size: 10px;
      color: #444;
    }

    .user-list-panel {
      width: 140px;
      display: flex;
      flex-direction: column;
      background: #c0c0c0;
    }

    .user-list-header {
      padding: 4px 8px;
      background: #c0c0c0;
      border-bottom: 1px solid #808080;
      font-size: 11px;
      font-weight: bold;
      text-align: center;
    }

    .user-list {
      flex: 1;
      overflow-y: auto;
      padding: 4px 0;
      background: #fff;
      font-family: "Fixedsys", "Courier New", monospace;
      font-size: 12px;
    }

    .user-item {
      padding: 1px 8px;
      white-space: nowrap;
    }

    .user-item:hover {
      background: #000080;
      color: #fff;
    }

    .user-prefix {
      color: #808080;
      font-weight: bold;
    }

    @media (max-width: 600px) {
      #irc-client {
        max-width: 100%;
        border: none;
        box-shadow: none;
      }
      .user-list-panel { display: none; }
      .menu-bar { display: none; }
    }
  </style>
</body>
</html>
