---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import getparlo from "../assets/works/getparlo.png";
import haikuNews from "../assets/works/haiku-news.png";
import tellMeAStory from "../assets/works/tell-me-a-story.png";
import plexodoro from "../assets/works/plexodoro.png";

const projects = [
  {
    title: "Plexodoro",
    description: "A Pomodoro timer that plays music from your Plex library. macOS menu-bar + iOS, single Swift codebase.",
    image: plexodoro,
    url: "https://fourseven.github.io/plexodoro/",
  },
  {
    title: "Parlo",
    description: "Your money, explained. NZ spending insights via open banking.",
    image: getparlo,
    url: "https://getparlo.app",
  },
  {
    title: "Haiku News Quiz",
    description: "A news quiz in the form of a haiku.",
    image: haikuNews,
    url: "https://haiku-news-quiz.vercel.app",
  },
  {
    title: "Tell Me A Story",
    description: "Write a story using emojis.",
    image: tellMeAStory,
    url: "https://tell-me-a-story.vercel.app",
  },
];

const experiments = [
  {
    title: "Never-Ending Story",
    description: "Star Wars crawl meets Gemini Nano. An AI-generated children's story that writes itself forever, entirely in your browser.",
    url: "/story",
    requires: "Chrome desktop with built-in AI enabled",
  },
];
---

<Base title="Works - MathewHartley.com">
  <div class="works-hero">
    <h1>Welcome to Works</h1>
    <p>Works represents a suite of SaaS ideas, from experiments to complete products.</p>
    <p>If you're looking for a new idea, or just want to see what I'm working on, you're in the right place.</p>
  </div>

  <section class="works-content">
    <h2>My Works</h2>
    <div class="works-grid">
      {projects.map((project) => (
        <a href={project.url} class="works-card" target="_blank" rel="noopener noreferrer">
          <Image src={project.image} alt={"Screenshot of " + project.title} loading="lazy" width={1280} height={720} />
          <div class="works-card-body">
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <span class="visit-link">Click to visit &gt;&gt;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="works-content experiments">
    <h2>Experiments</h2>
    <div class="works-grid">
      {experiments.map((exp) => (
        <a href={exp.url} class="works-card experiment-card">
          <div class="experiment-badge">Chrome AI</div>
          <div class="works-card-body">
            <h3>{exp.title}</h3>
            <p>{exp.description}</p>
            {exp.requires && <span class="requires">Requires: {exp.requires}</span>}
            <span class="visit-link">Try it out &gt;&gt;</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .works-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }

  .works-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .works-hero p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 32rem;
    margin: 0 auto 0.5rem;
  }

  .works-content {
    padding-top: 2rem;
    text-align: center;
  }

  .works-content h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .works-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 36rem;
    margin: 0 auto;
  }

  .works-card {
    display: flex;
    flex-direction: column;
    background: var(--color-card-bg);
    border: 3px ridge var(--color-border);
    text-decoration: none;
    overflow: hidden;
    position: relative;
  }

  .works-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-hot-pink), var(--color-cyan), var(--color-yellow));
    background-size: 200% 100%;
    animation: marquee-bg 3s linear infinite;
    z-index: 1;
  }

  .works-card:hover {
    border-color: var(--color-cyan);
    box-shadow: 0 0 15px #00ffff33;
  }

  .works-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 2px ridge var(--color-border);
  }

  .works-card-body {
    padding: 1.25rem 1.5rem;
    text-align: left;
  }

  .works-card-body h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-cyan);
    text-shadow: 1px 1px 0 #000;
    margin-bottom: 0.35rem;
  }

  .works-card:hover .works-card-body h3 {
    color: var(--color-yellow);
    text-shadow: 1px 1px 0 #000, 0 0 8px #ffff0066;
  }

  .works-card-body p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .visit-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
  }

  .works-card:hover .visit-link {
    color: var(--color-yellow);
    text-shadow: 0 0 6px #ffff0066;
  }

  .experiments {
    padding-top: 3rem;
    border-top: 2px ridge var(--color-border);
    margin-top: 2rem;
  }

  .experiment-card {
    min-height: 10rem;
    justify-content: center;
  }

  .experiment-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
    background: var(--color-hot-pink);
    color: #fff;
    border: 1px solid var(--color-hot-pink);
    z-index: 2;
  }

  .requires {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-orange);
    margin-bottom: 0.5rem;
  }
</style>
