---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const tags = post.data.tags.split(",").map((t: string) => t.trim());
const postUrl = new URL(`/blog/${post.id}`, Astro.site).href;
const postSummary = post.body
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/<[^>]*>/g, " ")
  .replace(/^#{1,6}\s+/gm, "")
  .replace(/[*_`~>]/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const sentences = postSummary.match(/[^.!?]+(?:[.!?]|$)/g) ?? [];
const summary = sentences.reduce((selected, sentence) => {
  const next = [selected, sentence.trim()].filter(Boolean).join(" ");
  return next.length <= 160 ? next : selected;
}, "");
const description = summary || (postSummary.length > 160
  ? `${postSummary.slice(0, 157).replace(/\s+\S*$/, "").trimEnd()}...`
  : postSummary) || post.data.title;

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: "Mathew Hartley",
    url: "https://www.mathewhartley.com",
  },
  publisher: {
    "@type": "Person",
    name: "Mathew Hartley",
    url: "https://www.mathewhartley.com",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  url: postUrl,
  keywords: tags.join(", "),
};
---

<Base
  title={`${post.data.title} - MathewHartley.com`}
  description={description}
  ogType="article"
  jsonLd={blogPostingJsonLd}>
  <article class="article">
    <h1>{post.data.title}</h1>
    <time datetime={post.data.date.toISOString()}>
      Posted on {post.data.date.toLocaleDateString("en-NZ", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>
    <Content />
    <div class="tags">
      {tags.map((tag: string) => (
        <a href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, "-")}`}>{tag}</a>
      ))}
    </div>
  </article>

  <div class="sidebar-box" style="margin-top: 2rem;">
    <h3>&#128279; Navigate</h3>
    <ul>
      <li><a href="/blog">&#8592; Back to Blog</a></li>
      <li><a href="/">Home</a></li>
    </ul>
  </div>
</Base>
